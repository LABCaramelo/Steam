{
  "name": "steam-recriada",
  "private": true,
  "version": "0.1.0",
  "description": "Recriação de estudo do cliente desktop da Steam, reconstruída a partir da análise (REA) da steamui instalada.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types server/*.test.ts",
    "caramelo:sync": "node scripts/sync-caramelo.mjs",
    "prompts:import": "node scripts/import-prompts.mjs",
    "seeds:compile": "node scripts/compile-seeds.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@caramelo/design-system": "file:vendor/caramelo-design-system-2.0.0.tgz",
    "@mdi/font": "7.4.47",
    "@supabase/supabase-js": "^2.118.0",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "codemirror": "5.65.21",
    "country-flag-icons": "1.6.20",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.18.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "vuetify": "3.12.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.8.3",
    "vite": "^6.4.5"
  }
}
