{
  "name": "steam-recriada",
  "private": true,
  "version": "0.1.0",
  "description": "Recriação de estudo do cliente desktop da Steam, reconstruída a partir da análise (REA) da steamui instalada.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types server/*.test.ts",
    "caramelo:sync": "node scripts/sync-caramelo.mjs"
  },
  "dependencies": {
    "@caramelo/design-system": "file:vendor/caramelo-design-system-2.0.0.tgz",
    "@supabase/supabase-js": "^2.118.0",
    "country-flag-icons": "1.6.20",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
