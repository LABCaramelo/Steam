# ------------------------------------------------------------------------------
# Acesso ao LAB pelo grupo do WhatsApp (api/lab-access.ts). Só no servidor:
# configure também na Vercel (Settings → Environment Variables). Sem o prefixo VITE_,
# nunca entram no bundle do navegador. Sem elas, o LAB mostra "acesso não configurado".
# ------------------------------------------------------------------------------
# Server URL da uazapi (ex.: https://seu-servidor.uazapi.com)
UAZAPI_URL=
# Token da INSTÂNCIA conectada ao número que está no grupo (não o admin token)
UAZAPI_TOKEN=
# JID do grupo oficial (ex.: 120363000000000000@g.us). Descubra com:
#   node --env-file=.env scripts/uazapi-grupos.mjs
UAZAPI_GROUP_JID=
# Supabase → Project Settings → API → service_role (secreta: só no servidor)
SUPABASE_SERVICE_ROLE_KEY=
