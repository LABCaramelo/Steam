{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/prompts", "destination": "/tools/prompt-library/index.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/aula-head", "destination": "/aula-head/index.html" },
    { "source": "/aula-head/aula-01", "destination": "/aula-head/index.html" },
    { "source": "/tools/:slug(kanban|prancheta|automation|academy|claquete|comunidade)", "destination": "/tools/:slug/index.html" },
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
