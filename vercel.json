{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/prompts", "destination": "/tools/prompt-library/index.html", "permanent": true },
    { "source": "/favicon.ico", "destination": "/favicon.svg", "permanent": false }
  ],
  "rewrites": [
    { "source": "/aula-head", "destination": "/aula-head/index.html" },
    { "source": "/aula-head/aula-01", "destination": "/aula-head/index.html" },
    { "source": "/tools/:slug(prompt-library|kanban|prancheta|automation|academy|claquete|comunidade|admin|gravador|montagem)", "destination": "/tools/:slug/index.html" },
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
