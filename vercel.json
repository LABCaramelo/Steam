{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/trama.ts": { "maxDuration": 60 },
    "api/trama-hook.ts": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/prompts",
      "destination": "/tools/prompt-library",
      "permanent": true
    },
    {
      "source": "/appflowy",
      "destination": "/tools/caderno",
      "permanent": true
    },
    {
      "source": "/caderno",
      "destination": "/tools/caderno",
      "permanent": true
    },
    {
      "source": "/tools/:slug/index.html",
      "destination": "/tools/:slug",
      "permanent": true
    },
    {
      "source": "/tools/:slug(prompt-library|kanban|prancheta|automation|trama|academy|claquete|comunidade|admin|gravador|montagem|creative-os|gabinete|stories|logomotion|cap|voicestudio|caderno)/index.html",
      "destination": "/tools/:slug",
      "permanent": true
    },
    {
      "source": "/aula-head/index.html",
      "destination": "/aula-head",
      "permanent": true
    },
    {
      "source": "/head-de-conteudo/index.html",
      "destination": "/head-de-conteudo",
      "permanent": true
    },
    {
      "source": "/sites-e-experiencias/index.html",
      "destination": "/sites-e-experiencias",
      "permanent": true
    },
    {
      "source": "/projetos/um-cara-caramelo-conteudo/index.html",
      "destination": "/projetos/um-cara-caramelo-conteudo",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/head-de-conteudo",
      "destination": "/head-de-conteudo/index.html"
    },
    {
      "source": "/head-de-conteudo/",
      "destination": "/head-de-conteudo/index.html"
    },
    {
      "source": "/sites-e-experiencias",
      "destination": "/sites-e-experiencias/index.html"
    },
    {
      "source": "/sites-e-experiencias/",
      "destination": "/sites-e-experiencias/index.html"
    },
    {
      "source": "/aula-head",
      "destination": "/aula-head/index.html"
    },
    {
      "source": "/aula-head/aula-01",
      "destination": "/aula-head/index.html"
    },
    {
      "source": "/tools/:slug(prompt-library|kanban|prancheta|automation|trama|academy|claquete|comunidade|admin|gravador|montagem|creative-os|gabinete|stories|logomotion|cap|voicestudio|caderno)",
      "destination": "/tools/:slug/index.html"
    },
    {
      "source": "/tools/:slug(prompt-library|kanban|prancheta|automation|trama|academy|claquete|comunidade|admin|gravador|montagem|creative-os|gabinete|stories|logomotion|cap|voicestudio|caderno)/",
      "destination": "/tools/:slug/index.html"
    },
    {
      "source": "/projetos/um-cara-caramelo-conteudo",
      "destination": "/projetos/um-cara-caramelo-conteudo/index.html"
    },
    {
      "source": "/projetos/um-cara-caramelo-conteudo/",
      "destination": "/projetos/um-cara-caramelo-conteudo/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
